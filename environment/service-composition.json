{
  "compose_file": "environment/compose.integration.yml",
  "contract_version": "1",
  "declared_service_contracts": [
    {
      "configuration_env": [
        "REDIS_URL"
      ],
      "kind": "redis_session",
      "mode": "standalone",
      "name": "session"
    },
    {
      "configuration_env": [
        "RABBITMQ_URL"
      ],
      "event_queue": {
        "dead_letter_exchange": "kis.domain.events.dlx",
        "dead_letter_queue": "kis.profile.events.dead-letter",
        "exchange": "kis.domain.events",
        "outbox_stores": [
          "account",
          "automation"
        ],
        "queue": "kis.profile.events",
        "queue_type": "classic",
        "routing_key": "account.profile.#"
      },
      "kind": "rabbitmq",
      "name": "domain_events"
    }
  ],
  "durable_jobs": [
    {
      "event_type": "news.collection.requested",
      "name": "news_collection",
      "routing_key": "news.collection.requested",
      "schedule": "0 * * * *",
      "store": "automation"
    },
    {
      "event_type": "news.index.requested",
      "name": "news_index",
      "routing_key": "news.index.requested",
      "schedule": null,
      "store": "automation"
    },
    {
      "event_type": "durable-job.history.index.requested",
      "name": "durable_job_history_index",
      "routing_key": "durable-job.history.index.requested",
      "schedule": null,
      "store": "automation"
    },
    {
      "event_type": "market-price.snapshot.requested",
      "name": "market_price_snapshot",
      "routing_key": "market-price.snapshot.requested",
      "schedule": null,
      "store": "automation"
    }
  ],
  "profile": "local-integration",
  "services": [
    {
      "configuration_env": [
        "AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION",
        "AIRFLOW__CORE__EXECUTOR",
        "AIRFLOW__CORE__LOAD_EXAMPLES",
        "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN",
        "DURABLE_JOB_API_TOKEN",
        "DURABLE_JOB_API_URL"
      ],
      "dependencies": {
        "postgres": "service_healthy"
      },
      "healthcheck": false,
      "lifecycle": "one_shot",
      "name": "airflow-init",
      "published_ports": [],
      "restart_policy": "no",
      "role": "scheduler"
    },
